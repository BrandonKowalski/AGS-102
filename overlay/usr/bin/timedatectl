#!/bin/sh
# Minimal timedatectl compatibility for BaseOS's BusyBox init system.
# NextUI uses the Timezone/NTP properties plus set-timezone/set-ntp. Persistent
# choices live on /data; writable runtime state lives under /run.
set -eu

ZONEINFO_DIR="${BASEOS_ZONEINFO_DIR:-/usr/share/zoneinfo}"
DATA_DIR="${BASEOS_DATA_DIR:-/data}"
LOCALTIME_LINK="${BASEOS_LOCALTIME_LINK:-/run/localtime}"
TIMEZONE_STATE_FILE="$DATA_DIR/timezone"
NTP_STATE_FILE="${BASEOS_NTP_STATE_FILE:-$DATA_DIR/ntp-enabled}"
NTP_SYNC_FILE="${BASEOS_NTP_SYNC_FILE:-/run/baseos-ntp-synchronized}"
NTP_HELPER="${BASEOS_NTP_HELPER:-/usr/sbin/baseos-ntp}"
NTP_LOG="${BASEOS_NTP_LOG:-/var/log/baseos-ntp.log}"
DEFAULT_TIMEZONE="Etc/UTC"

valid_timezone() {
	case "$1" in
		""|/*|*..*) return 1 ;;
	esac
	[ -f "$ZONEINFO_DIR/$1" ]
}

current_timezone() {
	zone=""
	if [ -s "$TIMEZONE_STATE_FILE" ]; then
		IFS= read -r zone < "$TIMEZONE_STATE_FILE" || true
		if valid_timezone "$zone"; then
			printf '%s\n' "$zone"
			return 0
		fi
	fi

	link="$(readlink "$LOCALTIME_LINK" 2>/dev/null || true)"
	case "$link" in
		"$ZONEINFO_DIR"/*)
			zone="${link#"$ZONEINFO_DIR"/}"
			if valid_timezone "$zone"; then
				printf '%s\n' "$zone"
				return 0
			fi
			;;
	esac

	printf '%s\n' "$DEFAULT_TIMEZONE"
}

link_timezone() {
	zone="$1"
	tmp_link="$LOCALTIME_LINK.$$"
	rm -f "$tmp_link"
	ln -s "$ZONEINFO_DIR/$zone" "$tmp_link"
	mv -f "$tmp_link" "$LOCALTIME_LINK"
}

set_timezone() {
	zone="$1"
	if ! valid_timezone "$zone"; then
		printf 'timedatectl: invalid timezone: %s\n' "$zone" >&2
		return 1
	fi

	mkdir -p "$DATA_DIR"
	tmp_state="$TIMEZONE_STATE_FILE.$$"
	trap 'rm -f "$tmp_state" "$LOCALTIME_LINK.$$"' EXIT HUP INT TERM
	printf '%s\n' "$zone" > "$tmp_state"
	chmod 644 "$tmp_state"
	mv -f "$tmp_state" "$TIMEZONE_STATE_FILE"
	link_timezone "$zone"
	trap - EXIT HUP INT TERM
}

current_ntp() {
	value=""
	if [ -s "$NTP_STATE_FILE" ]; then
		IFS= read -r value < "$NTP_STATE_FILE" || true
	fi
	case "$value" in
		yes) printf 'yes\n' ;;
		*) printf 'no\n' ;;
	esac
}

current_ntp_synchronized() {
	if [ "$(current_ntp)" = "yes" ] && [ -s "$NTP_SYNC_FILE" ]; then
		printf 'yes\n'
	else
		printf 'no\n'
	fi
}

start_ntp() {
	[ "$(current_ntp)" = "yes" ] || return 0
	if [ ! -x "$NTP_HELPER" ]; then
		printf 'timedatectl: NTP helper is unavailable: %s\n' "$NTP_HELPER" >&2
		return 1
	fi
	mkdir -p "$(dirname "$NTP_LOG")"
	"$NTP_HELPER" run </dev/null >> "$NTP_LOG" 2>&1 &
}

set_ntp() {
	case "$1" in
		true|yes|1) enabled="yes" ;;
		false|no|0) enabled="no" ;;
		*)
			printf 'timedatectl: expected true or false, got: %s\n' "$1" >&2
			return 1
			;;
	esac

	mkdir -p "$DATA_DIR"
	tmp_state="$NTP_STATE_FILE.$$"
	trap 'rm -f "$tmp_state"' EXIT HUP INT TERM
	printf '%s\n' "$enabled" > "$tmp_state"
	chmod 644 "$tmp_state"
	mv -f "$tmp_state" "$NTP_STATE_FILE"
	trap - EXIT HUP INT TERM

	rm -f "$NTP_SYNC_FILE"
	if [ "$enabled" = "yes" ]; then
		start_ntp
	elif [ -x "$NTP_HELPER" ]; then
		"$NTP_HELPER" stop
	fi
}

show_property() {
	property=""
	shift
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-p|--property)
				[ "$#" -ge 2 ] || exit 2
				property="$2"
				shift 2
				;;
			--value) shift ;;
			*) shift ;;
		esac
	done

	case "$property" in
		Timezone) current_timezone ;;
		NTP) current_ntp ;;
		NTPSynchronized) current_ntp_synchronized ;;
		*) printf 'timedatectl: unsupported property: %s\n' "$property" >&2; return 1 ;;
	esac
}

case "${1:-}" in
	show)
		show_property "$@"
		;;
	set-timezone)
		[ "$#" -eq 2 ] || { printf 'usage: timedatectl set-timezone ZONE\n' >&2; exit 2; }
		set_timezone "$2"
		;;
	set-ntp)
		[ "$#" -eq 2 ] || { printf 'usage: timedatectl set-ntp BOOL\n' >&2; exit 2; }
		set_ntp "$2"
		;;
	apply)
		# BaseOS-private boot hook: restore persistent settings. NTP startup
		# only forks a detached worker; network waits remain off the boot path.
		link_timezone "$(current_timezone)"
		start_ntp
		;;
	*)
		printf 'timedatectl: unsupported command: %s\n' "${1:-}" >&2
		exit 1
		;;
esac
