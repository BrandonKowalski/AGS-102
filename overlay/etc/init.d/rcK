#!/bin/sh
# Shutdown: quiesce the frontend and the drivers that do not survive an abrupt
# teardown, then persist entropy, flush and unmount. Busybox init runs this for
# both poweroff and reboot.
#
# The quiesce exists because reboot(RB_POWER_OFF) walks every registered
# device's .shutdown() hook, and on this vendor kernel that hangs once the GPU
# has been used: the screen goes dark with the rails still up, drawing hundreds
# of milliamps, and on occasion latches so hard that only disconnecting the
# battery recovers it. Measured on an RG SP: a poweroff with no frontend running
# was genuinely off (gauge unmoved over 32 minutes), while the same command with
# the frontend running drained 245 mAh in 21 minutes.
#
# A module that has been unloaded is not in the kernel's shutdown list at all,
# which is why this rmmods rather than merely killing the frontend. That is the
# one thing sysvinit and systemd do not do, and it is strictly stronger than
# stopping services if the driver is what hangs.
#
# init has already stopped respawning by the time it runs the shutdown actions,
# so nothing here needs to signal it.

CARD=/mnt/sdcard
LOG="$CARD/ags-shutdown.log"
P=/sys/class/power_supply/axp2202-battery

# Appends only while the card is still mounted, which is true for everything
# above the umount at the end.
log() {
	if /bin/mountpoint -q "$CARD" 2>/dev/null; then
		echo "$*" >> "$LOG" 2>/dev/null
		/bin/sync
	fi
}

# START is written before any teardown work, and synced. Without it, a run that
# hangs partway through leaves no trace at all and cannot be told apart from a
# run that never happened — which is exactly the distinction this file exists to
# investigate.
log "=== rcK START $(/bin/date '+%Y-%m-%d %H:%M:%S') epoch=$(/bin/date +%s) uptime=$(/bin/cut -d' ' -f1 /proc/uptime) cap=$(/bin/cat $P/capacity 2>/dev/null)% counter=$(/bin/cat $P/charge_counter 2>/dev/null) status=$(/bin/cat $P/status 2>/dev/null) usb=$(/bin/cat /sys/class/power_supply/axp2202-usb/online 2>/dev/null)"

# The frontend owns /dev/mali0, the framebuffer and the codec. Give it a chance
# to exit on its own: it has a save state to write.
/usr/bin/killall slot 2>/dev/null
n=0
while /bin/pidof slot >/dev/null 2>&1 && [ "$n" -lt 50 ]; do
	/bin/sleep 0.1 2>/dev/null || /bin/sleep 1
	n=$((n + 1))
done
/usr/bin/killall -9 slot 2>/dev/null
log "    frontend exited after ${n}x100ms"

# mali_kbase is the suspect: it is the one clear difference between the poweroff
# that worked and the ones that hung. The radios cost nothing to drop and rtw
# drivers have a poor reputation on shutdown.
for m in mali_kbase 8821cs rtl_btlpm; do
	/sbin/rmmod "$m" 2>/dev/null
	log "    rmmod $m -> $?"
done

# Evidence, while the card is still writable. This cannot capture the kernel's
# own shutdown — that happens after init returns from here — but it does record
# how far the quiesce got, and anything the kill or the rmmods complained about.
log "    modules still loaded: $(/bin/cut -d' ' -f1 /proc/modules | tr '\n' ' ')"
if /bin/mountpoint -q "$CARD" 2>/dev/null; then
	/bin/dmesg | /usr/bin/tail -25 >> "$LOG" 2>/dev/null
fi
log "=== rcK DONE $(/bin/date '+%Y-%m-%d %H:%M:%S') — teardown complete"

/bin/dd if=/dev/urandom of=/data/random-seed bs=512 count=1 2>/dev/null
/bin/sync
echo s > /proc/sysrq-trigger 2>/dev/null

# Last chance to say anything: the card is unmounted immediately below.
if [ -e /run/poweroff-requested ]; then
	log "    poweroff requested — cutting power at the PMIC after unmount"
else
	log "    no poweroff marker — reboot path, handing back to init"
fi

# Unmount the two filesystems carrying state, by name. `umount -a` cannot be
# used ahead of the PMIC write below: it would take devtmpfs with it, and
# /dev/i2c-5 has to outlive this step.
/bin/umount /mnt/sdcard 2>/dev/null
/bin/umount /data 2>/dev/null
/bin/sync

# Power off at the PMIC rather than returning to init for reboot(RB_POWER_OFF).
# That path does not stay off while VBUS is present: the device is back in about
# seven seconds reporting bootreason=charger, which turns an idle handheld on a
# charger into a five-minute cycle as soon as the frontend's doze timeout fires.
# Writing the PMU's own soft-poweroff bit does stay off — measured 5/5 on an
# RG SP, from button and charger boots alike, with the card and both ext4
# filesystems clean afterwards every time.
#
# Only on a poweroff. BusyBox init runs this single `::shutdown:` action for
# reboot as well and gives no way to tell them apart, so /sbin/poweroff leaves a
# marker and a reboot never does. Absent the marker we take the reboot path on
# purpose: the two failures are not symmetric. A poweroff that falls through
# merely restarts on the charger — the behaviour this OS already shipped — while
# a reboot that powers off strands baseos-update after a slot flip, where the
# trial-boot counter then rolls the update back.
#
# Execution ends inside axp-off. If the write fails it returns non-zero and the
# umount below runs, handing back to init exactly as this script always did.
if [ -e /run/poweroff-requested ] && [ -x /usr/sbin/axp-off ]; then
	/usr/sbin/axp-off --now
fi

/bin/umount -a -r 2>/dev/null
