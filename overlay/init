#!/bin/sh
# PID 1 entry point, exec'd by the vendor initramfs switch_root.
#
# A regular script, not a symlink: the 2015-era initramfs busybox chokes on our
# /init -> sbin/init -> busybox symlink chain (see docs/00 §2).
#
# It used to leave raw stage markers in the sacrificial appfs stub so a frozen
# boot was diagnosable from a card reader. That partition no longer exists —
# the region became the unallocated A/B rootfs slot — and the markers had done
# their job during bring-up. Boot forensics now live in /run/boot-*,
# /data/expand.log and /data/update/log.

exec /usr/bin/busybox init
