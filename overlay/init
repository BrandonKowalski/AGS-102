#!/bin/sh
# PID 1 entry point, exec'd by the vendor initramfs switch_root.
# A regular script (not a symlink): the 2015-era initramfs busybox and the
# kernel both exec this trivially, and each stage below leaves a raw marker
# in the sacrificial p6 stub so a frozen boot is diagnosable from any card
# reader without serial access.
#   stage A @ sector 8192: this shell is alive (static busybox sh works)
#   stage B @ sector 8194: about to exec busybox init
#   (inittab writes its own marker @ sector 8196; rcS logs to the FAT card)

echo "BASEOS STAGE-A shell-alive" | /usr/bin/busybox dd of=/dev/mmcblk0p6 bs=512 seek=8192 conv=notrunc 2>/dev/null
/usr/bin/busybox sync
/usr/bin/fbsplash 10 2>/dev/null

echo "BASEOS STAGE-B exec-init" | /usr/bin/busybox dd of=/dev/mmcblk0p6 bs=512 seek=8194 conv=notrunc 2>/dev/null
/usr/bin/busybox sync
exec /usr/bin/busybox init
